# --- Credentials. Any one is enough to start. ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# --- Model selection ---
MODEL=groq:llama-3.3-70b-versatile
FALLBACK_MODELS=
THINKING=
ITERATION_BUDGET=12

# --- Tools ---
# Enabled toolsets. 'files' only by default; add shell and web on purpose.
TOOLSETS=files
MAX_PARALLEL_TOOLS=8
# Let file tools reach outside the working directory. Off by default.
HERMES_ALLOW_OUTSIDE_WORKSPACE=0
LOCAL_BASE_URL=http://localhost:11434/v1

# --- Where state lives ---
# Root for threads, the model cache, and recent projects.
# Use ./.hermes to keep everything beside the project instead of in $HOME.
HERMES_STATE_DIR=~/.hermes_ui

# Optional: override any of these individually.
# HERMES_THREADS_DIR=
# HERMES_MODEL_CACHE=
# HERMES_RECENTS_FILE=
# HERMES_NOTES_FILE=NOTES.md
